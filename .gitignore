# Repository scope
# Keep the repo focused on the hand-written shared config and private skills.
# skills/ is the composed catalogue generated by setup.sh (symlinks plus
# harness-installed system skills); repos/ holds external skill repo clones.
skills/
repos/
archive/

# macOS / editor noise
.DS_Store
**/.DS_Store

# Python cache / bytecode
__pycache__/
**/__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Local environment files
.env
.env.*

# Logs and transient runtime files
*.log
*.lock
*.tmp

# Local automation / workspace artefacts
private/
.claude/
.agents/
.ai-orchestrator/

# Centralized per-tool settings/hooks — these are rewritten by the tools
# themselves at runtime (timestamps, cached state), so they sync via iCloud
# on the physical repo directory rather than via git commits.
home-config/
